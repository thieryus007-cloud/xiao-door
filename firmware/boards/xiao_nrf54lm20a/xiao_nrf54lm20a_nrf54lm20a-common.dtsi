#include "xiao_nrf54lm20a_nrf54lm20a-pinctrl.dtsi"
#include <zephyr/dt-bindings/regulator/npm13xx.h>

/ {
	leds {
		compatible = "gpio-leds";

		blue_led: blue_led {
			gpios = <&gpio1 23 GPIO_ACTIVE_HIGH>;
			label = "BLUE_LED";
		};

		red_led: red_led {
			gpios = <&gpio1 22 GPIO_ACTIVE_HIGH>;
			label = "RED_LED";
		};

		green_led: green_led {
			gpios = <&gpio1 24 GPIO_ACTIVE_HIGH>;
			label = "GREEN_LED";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm20 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_led1: pwm_led_1 {
			pwms = <&pwm20 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
		pwm_led2: pwm_led_2 {
			pwms = <&pwm20 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Push button 0";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	pmic_i2c: pmic-i2c {
		compatible = "gpio-i2c";
		#address-cells = <1>;
		#size-cells = <0>;
		/* GPIO_OPEN_DRAIN + GPIO_PULL_UP indispensables (diagnostiqué le
		 * 17/08/2026 : mfd_npm13xx_init() échouait avec -EIO de façon 100%
		 * déterministe, y compris avec 500ms de délai de boot ajouté avant --
		 * ce qui a écarté un problème de timing). Le driver i2c_gpio.c ne fait
		 * que gpio_pin_set_dt(pin, state), sans jamais reconfigurer la
		 * direction -- il attend que le pin lui-même soit en open-drain
		 * matériel (écrire 1 = relâche/Hi-Z, écrire 0 = tire à la masse), avec
		 * un pull-up pour remonter à l'état haut au relâchement. Documenté
		 * explicitement dans le commentaire d'en-tête du driver ("the SDA pin
		 * as open-collector/open-drain with a pull-up resistor") -- sans
		 * OPEN_DRAIN, le pin pousse activement le niveau haut (push-pull),
		 * empêchant le PMIC de tirer la ligne à la masse pour acquitter
		 * (ACK) : toute transaction I2C échoue avec -EIO, quel que soit le
		 * délai de boot ajouté avant. Sans PULL_UP en plus, même avec
		 * OPEN_DRAIN, la ligne flotterait au relâchement au lieu de remonter
		 * à l'état haut. */
		sda-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio1 16 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		clock-frequency = <100000>;
		status = "okay";

		pmic: npm1300@6b {
			compatible = "nordic,npm1300";
			reg = <0x6b>;
			pmic_charger: charger {
				compatible = "nordic,npm1300-charger";
				term-microvolt = <4200000>;
				term-warm-microvolt = <4000000>;
				current-microamp = <150000>;
				dischg-limit-microamp = <1000000>;
				vbus-limit-microamp = <500000>;
				thermistor-ohms = <10000>;
				thermistor-beta = <3380>;
				charging-enable;
			};

			regulators {
				compatible = "nordic,npm1300-regulator";

				imu_vdd: dmic_vdd: LDO1 {
					regulator-init-microvolt = <3300000>;
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
				};
			};

			pmic_leds: leds {
				compatible = "nordic,npm1300-led";
				nordic,led0-mode = "error";
				nordic,led1-mode = "host";
				nordic,led2-mode = "host";
			};
		};
	};

	aliases {
		led0 = &blue_led;
		led1 = &red_led;
		led2 = &green_led;
		pwm-led0 = &pwm_led0;
		pwm-led1 = &pwm_led1;
		pwm-led2 = &pwm_led2;
		sw0 = &button0;
		watchdog0 = &wdt31;
		imu0 = &lsm6ds3tr_c;
		dmic20 = &pdm20;
	};
};

&uart20 {
	current-speed = <115200>;
	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart21 {
	current-speed = <115200>;
	pinctrl-0 = <&uart21_default>;
	pinctrl-1 = <&uart21_sleep>;
	pinctrl-names = "default", "sleep";
};

&i2c22 {
	pinctrl-0 = <&i2c22_default>;
	pinctrl-1 = <&i2c22_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;
};

&i2c30 {
	pinctrl-0 = <&i2c30_default>;
	pinctrl-1 = <&i2c30_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;
};

&spi23 {
	pinctrl-0 = <&spi23_default>;
	pinctrl-1 = <&spi23_sleep>;
	pinctrl-names = "default", "sleep";
};

&pdm20 {
	pinctrl-0 = <&pdm20_default>;
	pinctrl-1 = <&pdm20_sleep>;
	pinctrl-names = "default", "sleep";
	clock-source = "PCLK32M";
};

&pwm20 {
    status = "okay";
	pinctrl-0 = <&pwm20_default>;
	pinctrl-1 = <&pwm20_sleep>;
	pinctrl-names = "default", "sleep";
};
