/*
 * Bascule le contrôleur Bluetooth LE de la SoftDevice Controller de Nordic
 * vers le contrôleur logiciel de Zephyr (bt_hci_controller / sw-split),
 * en test pour contourner https://github.com/Seeed-Studio/platform-seeedboards/issues/65
 * (BLE ne diffuse jamais réellement avec la SoftDevice Controller sur ce SoC).
 */

&bt_hci_sdc {
	status = "disabled";
};

&bt_hci_controller {
	status = "okay";
};

/ {
	chosen {
		zephyr,bt-hci = &bt_hci_controller;
	};
};
