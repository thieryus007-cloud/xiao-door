#include <zephyr/dt-bindings/regulator/npm13xx.h>

&pmic_i2c {
	sda-gpios = <&gpio1 18 GPIO_ACTIVE_HIGH>;
	scl-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&pmic {
	regulators {
		imu_vdd: LDO1 {
			/delete-property/ regulator-boot-on;
			regulator-init-microvolt = <3300000>;
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-initial-mode = <NPM13XX_LDSW_MODE_LDO>;
		};
	};
};

&lsm6ds3tr_c {
	zephyr,deferred-init;
};

/* Réveil matériel + System OFF (recherche du 2026-08-23,
 * Recherche-Reveil-Materiel-XIAO.md) : région RAM retenue à travers le
 * System OFF, pour conserver packet_id / derniers angles envoyés /
 * échéances GRTC entre deux redémarrages. Repris tel quel de l'exemple
 * officiel Zephyr `samples/boards/nordic/system_off/boards/
 * nrf54lm20dk_nrf54lm20_a_b_cpuapp.dtsi` -- même SoC (nRF54LM20A), même
 * cpuapp_sram de base (511 KB à 0x20000000, vérifié dans
 * zephyr/dts/vendor/nordic/nrf54lm20_a_b.dtsi), donc directement
 * transposable : 511 - 4 = 507 KB utilisables + 4 KB retenus.
 */
/ {
	cpuapp_sram@2007ec00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2007ec00 DT_SIZE_K(4)>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	aliases {
		retainedmemdevice = &retainedmem0;
	};
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(507)>;
	ranges = <0x0 0x20000000 0x7ec00>;
};

/* Battery-powered door sensor: no status LED should ever be lit. LED0
 * defaults to "error" mode on this board, which the PMIC drives
 * autonomously in hardware (lights up e.g. when no battery is detected) --
 * switch it to "host" mode (software-controlled) so it stays off, since
 * nothing in this firmware ever turns it on.
 */
&pmic_leds {
	nordic,led0-mode = "host";
};

/* Not needed for this IMU-over-UART test; nrf_usbhs_wrapper.c fails to
 * build against this SoC/DT snapshot when the wrapper node is left enabled. */
&usbhs {
	status = "disabled";
};

&usbhs_wrapper {
	status = "disabled";
};
