/* Etape 2 (2026-08-27) -- base System OFF validee (test #13, 3,02 uA) +
 * GRTC + RAM retenue + BLE/BTHome (trame B sante/batterie uniquement,
 * pas de trame A/C -- necessitent des donnees IMU, reportees a l'etape
 * IMU separee). Pas de reveil IMU/bouton dans ce test : reveil GRTC
 * uniquement. */

/* Audit broches (2026-08-28) -- &uicr { nfct-pins-as-gpios; } RETIRE
 * D'URGENCE : mesure PPK2 avec ce changement + le pull-down INT1 (voir
 * main.c) ENSEMBLE a montre un pic ~200 mA inedit. Pas de variable
 * unique isolee -- retire par precaution en attendant un retest separe.
 * Raisonnement d'origine (probablement toujours valide, P1.01/P1.02
 * jamais routees sur ce board) conserve dans
 * XIAO-nRF54LM20A-Solution-System-OFF.md pour un futur retest isole. */

&power_en {
	/delete-property/ regulator-boot-on;
};

#include <zephyr/dt-bindings/regulator/npm13xx.h>

/* Test #22 (2026-08-28) -- imu_vdd/LDO1 active/desactive a chaque
 * cycle par sample_motion() (main.c) -- PAS de regulator-boot-on,
 * controle manuel indispensable au sondage a faible rapport cyclique. */
&pmic {
	regulators {
		imu_vdd: LDO1 {
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			/* Test #30 (2026-08-28) -- zephyr,deferred-init TENTE
			 * ici, ECHEC DE COMPILATION : propriete non declaree
			 * dans le binding nordic,npm1300-regulator.yaml (les
			 * noeuds enfants "regulateur" ne supportent pas l'init
			 * differee comme un device top-level tel que le
			 * capteur LSM6DSL -- piste techniquement fermee sur ce
			 * binding). Non applique. */
		};
	};
};

/* Init differee du driver LSM6DSL -- necessaire : le SYS_INIT
 * automatique tournerait avant que main() ait active imu_vdd (avant
 * toute alimentation), echouerait silencieusement. Voir
 * sample_motion() dans main.c pour le device_init() explicite. */
&lsm6ds3tr_c {
	zephyr,deferred-init;
};

/* Test #29 (2026-08-28) -- init differee du driver chargeur nPM1300.
 * Son init() ecrit ~12-15 transactions I2C (tension de terminaison,
 * limites de courant, thermistance, trickle-charge, activation charge)
 * a CHAQUE demarrage, meme sans lecture batterie -- negligeable a
 * 1/15 min, suspecte d'etre le facteur dominant a 1/s (voir analyse
 * tests #26-28, salve dense de nombreux pics courts, ~90-100 uC/cycle
 * constant quel que soit l'intervalle). device_init() explicite
 * uniquement quand une lecture batterie est reellement necessaire
 * (voir read_battery() dans main.c, deja gate par health_due). */
&pmic_charger {
	zephyr,deferred-init;
};

/* Region RAM retenue (packet_id, echeances GRTC) -- reprise telle quelle
 * de l'exemple officiel Zephyr system_off pour ce SoC (cpuapp_sram de
 * base 511 KB, meme calcul que la production : 507 KB utilisables +
 * 4 KB retenus). */
/ {
	cpuapp_sram@2007ec00 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2007ec00 DT_SIZE_K(4)>;
		zephyr,memory-region = "RetainedMem";
		status = "okay";

		retainedmem0: retainedmem {
			compatible = "zephyr,retained-ram";
			status = "okay";
		};
	};

	aliases {
		retainedmemdevice = &retainedmem0;
	};
};

&cpuapp_sram {
	reg = <0x20000000 DT_SIZE_K(507)>;
	ranges = <0x0 0x20000000 0x7ec00>;
};

&pmic_leds {
	status = "disabled";
};

&py25q64 {
	status = "okay";
};

/* Meme bug de build deja rencontre dans ce projet (nrf_usbhs_wrapper.c),
 * necessaire pour compiler quel que soit le test. */
&usbhs {
	status = "disabled";
};

&usbhs_wrapper {
	status = "disabled";
};
